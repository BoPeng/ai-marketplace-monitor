<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{{ digest.title }}</title>
    {% include "email_style.html.j2" %}
</head>
<body>
    {% macro listing_rows(listings, with_comment, limit) %}
    {% for listing in listings[:limit] %}
    <tr>
        <td style="padding: 8px 12px;">
            {% if listing.rating is not none %}<span class="status-tag {{ 'status-new' if not with_comment else 'status-sent' }}">{{ listing.rating }}</span>{% endif %}
            <a href="{{ listing.url }}" style="color: #2C5364; font-weight: bold;">{{ listing.title }}</a>
            <span style="color: #666666;">{% if listing.price %}{{ listing.price }}{% endif %}{% if listing.location %}, {{ listing.location }}{% endif %}</span>
            {% if listing.state %}<span class="status-tag status-sent">{{ listing.state|capitalize }}</span>{% endif %}
            {% if with_comment and listing.comment %}
            <div style="color: #666666; font-size: 14px;"><em>{{ listing.comment }}</em></div>
            {% endif %}
        </td>
    </tr>
    {% endfor %}
    {% if listings|length > limit %}
    <tr><td style="padding: 8px 12px; color: #666666;">…and {{ listings|length - limit }} more</td></tr>
    {% endif %}
    {% endmacro %}
    <div class="wrapper">
        <!-- Header -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td class="header">
                    <h1>AI Marketplace Monitor</h1>
                </td>
            </tr>
        </table>

        <!-- Content -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td class="content">
                    <h2>Daily digest</h2>
                    <p style="color: #666666; margin-top: 0;">Listings evaluated {{ digest.window }} ({{ digest.period }}). A listing still on the market is evaluated again on every search, so it can appear in more than one digest.</p>
                    {% if not digest.total.notified %}
                    <p><b>{{ no_matches }}</b></p>
                    {% endif %}

                    <!-- Summary -->
                    <table class="listing-table" cellpadding="0" cellspacing="0" border="0" style="font-size: 14px;">
                        {% for label, value in [
                            ("Searches", digest.total.searches),
                            ("Listings evaluated", digest.total.evaluated),
                            ("Notified", digest.total.notified|length),
                            ("Rejected by AI", digest.total.rejected|length),
                            ("Excluded", digest.total.n_excluded),
                        ] %}
                        <tr><td style="font-weight: bold; color: #333333;">{{ label }}</td><td>{{ "{:,}".format(value) }}</td></tr>
                        {% endfor %}
                    </table>
                    {% if digest.total.excluded %}
                    <p style="color: #666666; font-size: 14px;">Excluded:
                        {% for reason, n in digest.total.excluded|dictsort(by='value', reverse=true) %}{{ reason }} {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}
                    </p>
                    {% endif %}

                    {% for item in digest.items %}
                    <h2 style="margin-top: 30px;">{{ item.name }}</h2>
                    <p style="color: #666666; font-size: 14px; margin-top: 0;">{{ "{:,}".format(item.searches) }} searches, {{ "{:,}".format(item.evaluated) }} evaluated, {{ "{:,}".format(item.notified|length) }} notified, {{ "{:,}".format(item.rejected|length) }} rejected by AI, {{ "{:,}".format(item.n_excluded) }} excluded</p>
                    {% if item.summary %}
                    <p style="font-size: 15px; background: #F4F7F9; border-left: 3px solid #2C5364; padding: 10px 12px;">{{ item.summary }}</p>
                    {% endif %}
                    {% if item.notified %}
                    <h3 style="color: #2C5364; font-size: 16px; margin: 0;">Notified ({{ item.notified|length }})</h3>
                    <table class="listing-table" cellpadding="0" cellspacing="0" border="0">
                        {{ listing_rows(item.notified, false, max_entries) }}
                    </table>
                    {% endif %}
                    {% if item.updates %}
                    <h3 style="color: #2C5364; font-size: 16px; margin: 0;">Updates ({{ item.updates|length }})</h3>
                    <table class="listing-table" cellpadding="0" cellspacing="0" border="0">
                        {{ listing_rows(item.updates, false, max_entries) }}
                    </table>
                    {% endif %}
                    {% if item.rejected %}
                    <h3 style="color: #2C5364; font-size: 16px; margin: 0;">Rejected by AI ({{ item.rejected|length }})</h3>
                    <table class="listing-table" cellpadding="0" cellspacing="0" border="0">
                        {{ listing_rows(item.rejected, true, max_rejected) }}
                    </table>
                    {% endif %}
                    {% endfor %}
                </td>
            </tr>
        </table>

        <!-- Footer -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td class="footer">
                    <p>This is an automated daily digest from <a href="https://github.com/BoPeng/ai-marketplace-monitor">AI Marketplace Monitor</a></p>
                    <p>To stop it, remove the <code>digest_at</code> option of your user section.</p>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
