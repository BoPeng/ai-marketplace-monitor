# Settings for docker-compose.yml. Copy this file to .env, fill it in, and run `chmod 600 .env`.
# Put each value in single quotes so that a `$` in a password is not read as a variable.

# The Facebook account aimm logs in with. These also sign you in to the web UI.
FACEBOOK_USERNAME='you@example.com'
FACEBOOK_PASSWORD='your-facebook-password'

# UnitySVC: sign up at https://unitysvc.com and create an API key. In the default configuration
# this one key covers the AI that rates listings (OpenAI, Anthropic and other engines, as
# UnitySVC platform services or with your own provider keys saved as UnitySVC secrets) and the
# email and phone/chat notifications.
UNITYSVC_API_KEY='svcpass_...'

# Other providers, if your config.toml uses them (e.g. api_key = "${OPENAI_API_KEY}")
# OPENAI_API_KEY='sk-...'
# ANTHROPIC_API_KEY='sk-ant-...'

# Your time zone, for the daily digest
TZ='America/Chicago'

# On a Linux host where your user ID is not 1000, your `id -u` and `id -g`, so that the files
# in ./data stay yours. Docker Desktop on macOS and Windows does not need them.
# PUID=1000
# PGID=1000

# The port of the web UI on this machine
# AIMM_PORT=8467

# How much the container log and the web UI's Logs tab show: DEBUG, INFO (the default),
# WARNING or ERROR. The log file in the data folder always records everything.
# AIMM_LOG_LEVEL=INFO

# With docker-compose.override.yml (Traefik): the domain that serves aimm
# AIMM_DOMAIN='aimm.example.com'

# Who signs you in to the web UI. password (the default): aimm, with FACEBOOK_USERNAME and
# FACEBOOK_PASSWORD. If your reverse proxy signs users in instead, set authentik, cloudflare,
# authelia or proxy, with that mode's settings below (see "Let the reverse proxy sign you in"
# in the guide).
AIMM_WEBUI_AUTH=password
# AIMM_WEBUI_PROXY_SECRET='...'  # the proxy sends it as X-Aimm-Proxy-Secret (authelia, proxy)
# AIMM_WEBUI_JWKS_URL='https://auth.example.com/application/o/aimm/jwks/'  # authentik
# AIMM_WEBUI_CF_TEAM='myteam'  # cloudflare
# AIMM_WEBUI_JWT_AUDIENCE='...'  # cloudflare (AUD tag), authentik (provider client ID)
# AIMM_WEBUI_JWT_ISSUER='...'  # authentik, if it cannot be taken from AIMM_WEBUI_JWKS_URL
