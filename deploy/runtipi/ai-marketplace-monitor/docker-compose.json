{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "ai-marketplace-monitor",
      "image": "ghcr.io/bopeng/ai-marketplace-monitor:0.10.12",
      "isMain": true,
      "internalPort": 8467,
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "FACEBOOK_USERNAME",
          "value": "${FACEBOOK_USERNAME}"
        },
        {
          "key": "FACEBOOK_PASSWORD",
          "value": "${FACEBOOK_PASSWORD}"
        },
        {
          "key": "UNITYSVC_API_KEY",
          "value": "${UNITYSVC_API_KEY}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ]
    }
  ]
}
